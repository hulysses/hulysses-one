# Copy to .env and fill both passwords before starting Compose. Do not commit .env.
DB_NAME=hulysses
DB_USERNAME=hulysses
DB_PASSWORD=
DB_SCHEMA=public
PARTNER_DB_NAME=business_partner
PARTNER_DB_USERNAME=business_partner
PARTNER_DB_PASSWORD=
PARTNER_DB_SCHEMA=business_partner_service

# Internal application ports and ports published on the host.
SERVER_PORT=8080
PARTNER_SERVER_PORT=8081
CONFIG_SERVER_PORT=8888
APP_HOST_PORT=8080
PARTNER_HOST_PORT=8081
CONFIG_SERVER_HOST_PORT=8888

FEIGN_CONNECT_TIMEOUT=2000
FEIGN_READ_TIMEOUT=5000
CONFIG_CONNECT_TIMEOUT=2000
CONFIG_READ_TIMEOUT=5000
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
JPA_CREATE_NAMESPACES=true

# Optional: DB_URL, PARTNER_DB_URL, BUSINESS_PARTNER_SERVICE_URL, CONFIG_SERVER_URL.
# Compose defaults use service DNS names. localhost is only for host development.
